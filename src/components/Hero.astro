---
import Slider from "./Slider.astro";

const slides = [
  {
    image: "/images/img_001.jpg",
    title: "APOYANDO A LOS PRODUCTORES, GARANTIZANDO EL ABASTECIMIENTO",
    subtitle: "Compromiso con el desarrollo agrícola"
  },
  {
    image: "/images/img_002.jpg", 
    title: "DISTRIBUCIÓN EFICIENTE DE ALIMENTOS",
    subtitle: "Llegando a toda Bolivia"
  },
  {
    image: "/images/img_003.jpg", 
    title: "DISTRIBUCIÓN EFICIENTE DE ALIMENTOS",
    subtitle: "Llegando a toda Bolivia"
  },
  {
    image: "/images/img_006.jpg", 
    title: "DISTRIBUCIÓN EFICIENTE DE ALIMENTOS",
    subtitle: "Llegando a toda Bolivia"
  },
  // Más slides...
];

---

<section class="hero">
  <div class="hero-overlay"></div>
  
  <div class="hero-content">
    
    
    <Slider 
  slides={slides}
  height="70vh"
  autoplay={true}
  interval={5000}
/>



  </div>

  <div class="hero-background"></div>
</section>

<style>
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: all 0.5s ease;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #2c5530 0%, #1a3d1f 50%, #0f2415 100%);
    background-image: 
      radial-gradient(circle at 20% 80%, rgba(120, 180, 120, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(160, 140, 100, 0.1) 0%, transparent 50%);
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    width: 100%;
    height: 100%;
    padding: 0 2rem;
  }

  
</style>