---
// LegalDocs.astro
export interface Props {
  title?: string;
  className?: string;
}

const { title = "Documentación Legal", className = "" } = Astro.props;
---

<section class={`legal-docs ${className}`}>
  <div class="legal-docs-container">
    <div class="legal-docs-header">
      <div class="legal-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <polyline points="14,2 14,8 20,8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <polyline points="10,9 9,9 8,9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3>{title}</h3>
    </div>
    
    <p class="legal-description">
      Nuestra empresa cuenta con toda la documentación legal requerida. 
      Transparencia y cumplimiento normativo son nuestras prioridades.
    </p>

    <div class="legal-docs-grid">
      <a href="/docs/ley marco .pdf" class="legal-doc-item" target="_blank">
        <div class="doc-icon">📋</div>
        <div class="doc-info">
          <h4>Ley autonomica Indigena Originaria Campesina</h4>
          <span>Documento oficial de constitución / Ley N° 35/2025</span>
        </div>
      </a>

      <a href="/docs/precepto autonómico T´IKITA.pdf" class="legal-doc-item" target="_blank">
        <div class="doc-icon">🏢</div>
        <div class="doc-info">
          <h4>PRECEPTO AUTONOMICO COMUNITARIO N°13/2025</h4>
          <span>Creacion de la empresa publica comunitaria exclsiva con denominacion T'IKITA</span>
        </div>
      </a>

      <a href="/docs/REPRESENTANTE LEGAL.pdf" class="legal-doc-item" target="_blank">
        <div class="doc-icon">✅</div>
        <div class="doc-info">
          <h4>PRECEPTO AUTONOMICO COMUNITARIO N°13/2025</h4>
          <span>Designacion de Gerente general interino de la empresa publica comunitaria T'IKITA</span>
        </div>
      </a>
      <!--
      <a href="/docs/certificados.pdf" class="legal-doc-item" download>
        <div class="doc-icon">🎖️</div>
        <div class="doc-info">
          <h4>Certificaciones</h4>
          <span>Certificados de calidad y normas</span>
        </div>
      </a>-->
    </div>

    <div class="legal-footer">
      <p class="legal-note">
        <strong>Nota:</strong> Todos los documentos están actualizados y disponibles para verificación.
        Para consultas adicionales, <a href="#contacto" class="nav-link">contáctanos</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .legal-docs {
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    padding: 3rem 1rem;
    border-radius: 16px;
    margin: 2rem 0;
    border: 1px solid #e2e8f0;
  }

  .legal-docs-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .legal-docs-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    justify-content: center;
  }

  .legal-icon {
    background: #3b82f6;
    color: white;
    padding: 0.75rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .legal-docs-header h3 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
  }

  .legal-description {
    text-align: center;
    color: #64748b;
    font-size: 1.125rem;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .legal-docs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .legal-doc-item {
    background: white;
    padding: 1.5rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .legal-doc-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    border-color: #3b82f6;
  }

  .doc-icon {
    font-size: 2rem;
    background: #f1f5f9;
    padding: 0.75rem;
    border-radius: 8px;
    min-width: 60px;
    text-align: center;
  }

  .doc-info h4 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.25rem 0;
    color: #1e293b;
  }

  .doc-info span {
    font-size: 0.875rem;
    color: #64748b;
  }

  .legal-footer {
    background: white;
    padding: 1.5rem;
    border-radius: 12px;
    border-left: 4px solid #3b82f6;
  }

  .legal-note {
    margin: 0;
    color: #475569;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .legal-note a {
    color: #3b82f6;
    text-decoration: none;
    font-weight: 500;
  }

  .legal-note a:hover {
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .legal-docs {
      padding: 2rem 1rem;
    }
    
    .legal-docs-header {
      flex-direction: column;
      text-align: center;
    }
    
    .legal-docs-header h3 {
      font-size: 1.5rem;
    }
    
    .legal-docs-grid {
      grid-template-columns: 1fr;
    }
    
    .legal-doc-item {
      padding: 1.25rem;
    }
  }
</style>