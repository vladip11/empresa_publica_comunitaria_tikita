<div class="logo">
  <div class="logo-placeholder">
    <a href="#inicio" class="nav-link"><img src="./public/logo_002.png" alt="logo" height="220px" width="180px" ></a>
  </div>
</div>

<style>
 /* Contenedor principal del logo */
.logo {
  width: 100%;
  max-width: 120px; /* Cambia de 200px a 80px o el tamaño que necesites */
  padding: 10px;
  box-sizing: border-box;
}

/* Placeholder del logo */
.logo-placeholder {
  width: 100%;
  display: block;
}

/* Enlace del logo */
.logo-placeholder a {
  display: inline-block;
  width: 100%;
  text-decoration: none;
  transition: transform 0.3s ease;
}

/* Efecto hover opcional */
.logo-placeholder a:hover {
  transform: scale(1.05);
}

/* Imagen del logo - clave para responsividad */
.logo-placeholder img {
  width: 100%;
  height: auto;
  max-width: 100%;
  max-height: 200px; /* Agrega esto si quieres limitar la altura */
  display: block;
  object-fit: contain;
}

/* Media queries para diferentes tamaños */
@media (max-width: 768px) {
  .logo {
    max-width: 150px; /* Más pequeño en móviles */
    padding: 8px;
  }
}

@media (max-width: 480px) {
  .logo {
    max-width: 120px; /* Aún más pequeño en pantallas muy pequeñas */
    padding: 5px;
  }
}

/* Si quieres centrarlo */
.logo.center {
  margin: 0 auto;
}

/* Si va en una navbar/header */
.navbar .logo,
.header .logo {
  max-width: 160px;
  padding: 5px 0;
}
</style>