</section>

<style>
  .news-section {
    min-height: 100vh;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    color: #1f2937;
    display: none;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.5s ease;
    padding-top: 100px;
  }

  .news-section.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .news-header {
    background: linear-gradient(135deg, #3b82f6, #1e40af);
    padding: 3rem 2rem;
    text-align: center;
    color: white;
    position: relative;
    overflow: hidden;
  }

  .news-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" patternUnits="userSpaceOnUse" width="100" height="100"><circle cx="20" cy="20" r="2" fill="white" opacity="0.1"/><circle cx="80" cy="40" r="1.5" fill="white" opacity="0.08"/><circle cx="40" cy="80" r="2.5" fill="white" opacity="0.06"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
    opacity: 0.3;
  }

  .news-header h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 900;
    letter-spacing: 2px;
    margin-bottom: 1rem;
    position: relative;
    z-index: 2;
  }

  .news-header p {
    font-size: 1.2rem;
    opacity: 0.9;
    position: relative;
    z-index: 2;
  }

  .news-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .news-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: repeat(3, auto);
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .news-card.featured {
    grid-row: span 3;
  }

  .news-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .news-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }

  .news-image {
    position: relative;
    overflow: hidden;
  }

  .image-placeholder {
    height: 200px;
    background: linear-gradient(135deg, #10b981, #059669);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .featured .image-placeholder.main {
    height: 300px;
  }

  .category {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: white;
  }

  .category.community { background: #10b981; }
  .category.subsidio { background: #f59e0b; }
  .category.empresa { background: #6366f1; }
  .category.educacion { background: #ec4899; }
  .category.evento { background: #8b5cf6; }
  .category.mercado { background: #ef4444; }

  .news-icon {
    font-size: 3rem;
    opacity: 0.7;
    filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.3));
  }

  .featured .news-icon {
    font-size: 4rem;
  }

  .news-content-card {
    padding: 1.5rem;
  }

  .featured .news-content-card {
    padding: 2rem;
  }

  .news-date {
    color: #6b7280;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .news-card h3 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1rem;
    color: #1f2937;
  }

  .news-card h4 {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.8rem;
    color: #1f2937;
  }

  .news-card p {
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .read-more {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .read-more a {
    color: #3b82f6;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .read-more a:hover {
    color: #1e40af;
  }

  .read-more svg {
    color: #3b82f6;
    transition: transform 0.3s ease;
  }

  .read-more:hover svg {
    transform: translate(2px, -2px);
  }

  .news-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }

  .pagination-btn {
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 8px;
    background: white;
    color: #6b7280;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .pagination-btn:hover,
  .pagination-btn.active {
    background: #3b82f6;
    color: white;
    transform: translateY(-2px);
  }

  .pagination-btn.next {
    margin-left: 0.5rem;
  }

  @media (max-width: 1024px) {
    .news-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }

    .news-card.featured {
      grid-column: span 2;
      grid-row: span 1;
    }

    .featured .image-placeholder.main {
      height: 250px;
    }
  }

  @media (max-width: 768px) {
    .news-content {
      padding: 2rem 1rem;
    }

    .news-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .news-card.featured {
      grid-column: span 1;
      grid-row: span 1;
    }

    .featured .image-placeholder.main {
      height: 200px;
    }

    .news-header {
      padding: 2rem 1rem;
    }

    .news-header h1 {
      font-size: 2rem;
    }

    .news-header p {
      font-size: 1rem;
    }

    .news-card h3 {
      font-size: 1.3rem;
    }

    .news-card h4 {
      font-size: 1rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const paginationBtns = document.querySelectorAll('.pagination-btn');
    
    paginationBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        // Remove active from all buttons
        paginationBtns.forEach(b => b.classList.remove('active'));
        
        // Add active to clicked button (unless it's the next button)
        if (!this.classList.contains('next')) {
          this.classList.add('active');
        }
        
        // Here you would typically load new content
        console.log('Loading page:', this.textContent || 'next');
      });
    });
    
    // Smooth animations on scroll
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
        }
      });
    }, observerOptions);
    
    // Observe news cards for scroll animations
    const newsCards = document.querySelectorAll('.news-card');
    newsCards.forEach(card => {
      card.style.opacity = '0';
      card.style.transform = 'translateY(20px)';
      card.style.transition = 'all 0.6s ease';
      observer.observe(card);
    });
  });
</script>